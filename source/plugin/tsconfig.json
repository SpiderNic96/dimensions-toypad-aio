{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"],
    "types": ["react"],
    "baseUrl": "./",
    "paths": {
      "@decky/ui": ["./node_modules/@decky/ui"],
      "@decky/api": ["./node_modules/@decky/api"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
