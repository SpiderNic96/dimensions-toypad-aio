# Committed from Windows, consumed on Linux (Steam Deck).
# Without this, shell scripts get CRLF and fail on the Deck with:
#   bad interpreter: /usr/bin/env bash^M

* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.desktop text eol=lf

*.cmd     text eol=crlf
*.bat     text eol=crlf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.ico     binary
*.wav     binary
*.bin     binary
*.gz      binary
*.otf     binary
*.ttf     binary

# Large release artifacts via LFS (AppImages are never committed at all —
# see .gitignore — but keep the rule in case a path ever slips through).
*.zip filter=lfs diff=lfs merge=lfs -text
*.AppImage filter=lfs diff=lfs merge=lfs -text
# Large release artifact
release/reference/*.zip filter=lfs diff=lfs merge=lfs -text
dimensions-toypad-AIO-3_3_11.zip filter=lfs diff=lfs merge=lfs -text
